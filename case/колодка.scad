// Колодка-отвод CAN вместо штатного дисплея Citroën C4 — копия разъёма дисплея, и штекер (розовая фишка жгута).
//
// Как устроена пара (совмещение фото фишки 111/photo_6 и разъёма дисплея коннектор/photo_8, фишка-в-разъёме.png):
//  - в разъём входит розовая часть фишки: тело с гнёздами, слева (вид в разъём) защёлка в пазу на всю высоту,
//    справа внизу ключ в кармане, снизу справа прилив;
//  - рёбра разъёма у паза сверху и снизу заходят в щель между защёлкой и телом фишки;
//  - пустоты над и под телом — для плеч чёрного рычага фишки (он обходит розовый торец сверху и снизу),
//    блоки разъёма заполняют места, где рычага нет.
// Масштаб — по разъёму: паз защёлки 3.54 / 3.44, ребро → нижний блок 9.61, стенка → конец блока 13.78,
// длина блока 5.44 (штангель). Фишка вписана в разъём по внешним краям (защёлка — паз, рычаг — карман ключа,
// верх и низ рычага — верх и низ полости), масштаб по X и Y совпал (0.876 / 0.86).
// Старый шаблон по одному фото фишки (15.6 px/мм) был мелким примерно в 1.18 раза.
//
// Координаты: вид в полость с открытой стороны (как на фото дисплея), X вправо от левой стенки полости,
// Y вверх от низа полости, мм.
//
// Экспорт:
//   openscad -D 'part="shroud"' -o колодка.stl колодка.scad        (колодка с дном и окнами под штыри)
//   openscad -D 'part="test"'   -o колодка-проба.stl колодка.scad  (рамка 4 мм без дна — примерка фишки)
//   openscad -D 'part="plug"'   -o штекер.stl колодка.scad         (розовый торец фишки, гнёздами вниз)

part = "shroud";   // "shroud" — колодка, "test" — рамка для примерки, "plug" — штекер

// Полость — по замерам разъёма экрана штангелем (18.11), обход по контуру:
// низ: блок 5.7, между блоком и ребром 10, ребро 0.65, паз 3.5; левая стенка 13.2;
// верх: паз 3.5, ребро 0.65, 10, ступень 4, ступень 2.5; правая стенка 6, ключ 1.8.
// Правый нижний угол расширен под крестик фишки (ключ + прилив 2.0): карман 2.3 вместо 0.8, блок 4.2 вместо 5.7,
// карман ключа 2.2…4.62. Рёбра 0.65 у паза убраны.
// Не замерены (взяты с фото, масштаб 0.846 к прежней модели): высоты рёбер 2.58 / 2.31, ступеней 1.82 / 0.76,
// блока 1.39, вылет кармана ключа 1.7. Карман справа внизу 0.8 — остаток ширины (20.65 - 3.5 - 0.65 - 10 - 5.7).
W = 20.65;  H = 13.2;
cavity = [
  [0.00, H],                                                                    // рёбер 0.65 нет (не печатаются, для посадки не нужны)
  [14.15, H], [14.15, 11.38], [18.15, 11.38], [18.15, 10.62], [W, 10.62],      // верхние ступени 4 и 2.5
  [W, 4.62], [22.35, 4.62], [22.35, 2.20], [W, 2.20],                          // правая стенка 6, карман ключа (шире: крестик)
  [W, 0.00], [18.35, 0.00], [18.35, 1.39], [14.15, 1.39], [14.15, 0.00],       // карман под прилив 2.3, нижний блок 4.2
  [0.00, 0.00]
];
X_MAX = 22.35;

// розовый торец фишки в тех же координатах (без рычага)
plug_face = [
  [0.15, 0.15], [0.15, 13.05], [3.35, 13.05], [3.35, 10.47], [4.30, 10.47], [4.30, 10.42],  // защёлка
  [20.50, 10.42], [20.50, 4.47], [22.20, 4.47], [22.20, 2.35], [20.50, 2.35],               // тело, ключ
  [20.50, 0.15], [18.50, 0.15], [18.50, 1.83],                                              // прилив
  [4.30, 1.83], [4.30, 2.46], [3.35, 2.46], [3.35, 0.15]                                    // щель под нижнее ребро
];

// гнёзда фишки. По фото шаг ~2.33 (сходится с фото фишки). Проверить: крайние гнёзда ряда
// по внешним краям = 5 * pitch + ~1 мм (2.33 → ~12.6, 2.54 → ~13.7).
pitch = 2.33;
cx = W / 2;
cols = [for (i = [0:5]) cx + (i - 2.5) * pitch];
rows = [7.70, 4.97];

clear = 0.15;      // зазор на сторону (печать)
wall = 1.6;
depth = 4.8;       // глубина полости = торец фишки 4.5 + 0.3: торец ложится почти на дно, рычаг — на край
floor_t = 4.0;     // дно; корпуса дюпонов CAN проходят его насквозь, верх корпуса вровень с дном полости
dup_w = 2.6;       // корпус дюпона 2.54 — посадка плотная
// CAN — пины 7 и 9: верхний ряд, 1-й и 3-й столбцы слева (вид в полость, как на фото дисплея).
// Проверено на автомобиле 18.11: CAN на этих пинах работает.
can = [[0, 0], [2, 0]];   // [столбец, ряд]
pin_hole = 1.6;    // окно под штырь 0.64 (диагональ 0.9) с запасом на усадку печати; штырь сам встаёт по гнезду фишки
test_h = 4.0;
plug_h = 4.5;      // торец фишки (замер)
hole = 0.9;

eps = 0.01;

module cav() offset(delta = clear) polygon(cavity);

// снаружи — прямоугольник
module outer() translate([-clear - wall, -clear - wall])
  square([X_MAX + 2 * (clear + wall), H + 2 * (clear + wall)]);

// правый нижний угол (крестик: ключ вбок и прилив вниз) — с запасом, но не вскрыт целиком:
// ключ проходит через сквозное окно в правой стенке, под прилив карман 2.8; угловая стойка и низ остаются.
key_y0 = 1.9;  key_y1 = 4.9;   // окно под ключ по высоте (ключ ~2.35…4.47)
lug_x0 = W - 2.8;              // карман под прилив от сюда до правой стенки
module corner(z0, h) {
  translate([W - eps, key_y0, z0]) cube([10, key_y1 - key_y0, h]);   // окно в правой стенке
  translate([lug_x0, 0, z0]) cube([W - lug_x0 + eps, key_y1, h]);    // карман под прилив
}

module shroud() difference() {
  linear_extrude(floor_t + depth) outer();
  translate([0, 0, floor_t]) linear_extrude(depth + eps) cav();
  corner(floor_t, depth + eps);
  for (c = can)   // сквозное квадратное окно под пластиковый корпус дюпона: корпус вровень с дном полости
    translate([cols[c[0]] - dup_w / 2, rows[c[1]] - dup_w / 2, -eps]) cube([dup_w, dup_w, floor_t + 2 * eps]);
}

module test() difference() {
  linear_extrude(test_h) outer();
  translate([0, 0, -eps]) linear_extrude(test_h + 2 * eps) cav();
  corner(-eps, test_h + 2 * eps);
}

// лежит так, как входит в колодку: гнёздами вниз
module plug() difference() {
  linear_extrude(plug_h) polygon(plug_face);
  for (x = cols, y = rows)
    translate([x - hole / 2, y - hole / 2, -eps]) cube([hole, hole, plug_h + 2 * eps]);
}

if (part == "test") test(); else if (part == "plug") plug(); else shroud();
